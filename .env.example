# Local demo values only. Copy to .env if you want to override the compose defaults.
# Do not put production secrets in this file.

POSTGRES_DB=certichain
POSTGRES_USER=certichain
POSTGRES_PASSWORD=certichain
POSTGRES_PORT=5433

MINIO_ROOT_USER=certichain
MINIO_ROOT_PASSWORD=certichainsecret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=certichain

DB_URL=jdbc:postgresql://localhost:5433/certichain
DB_USERNAME=certichain
DB_PASSWORD=certichain

SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:5173

CHAIN_RPC_URL=http://localhost:8545
CHAIN_ID=31337
CHAIN_PORT=8545
OCR_URL=http://localhost:8070
OCR_PORT=8070
# Optional. The wallet still works if this service is down. OCR text is a suggestion, not a verification.
# Sepolia: set CHAIN_RPC_URL, CHAIN_PRIVATE_KEY, and CHAIN_ID=11155111.
# Never commit a funded private key.
# Wallet files use the same private MinIO bucket. No extra secret is required.
# Production verification links must be HTTPS. Local QR codes use the browser origin.
PUBLIC_APP_URL=http://localhost:5173
# Optional Ed25519 signing. Leave both blank and set the university key in Settings.
# A key saved there is used for new credentials. Each credential stores only the public key.
# If you set both variables, those keys are used instead and are not written to the database. Do not commit them.
CERTICHAIN_SIGNING_PRIVATE_KEY=
CERTICHAIN_SIGNING_PUBLIC_KEY=
# Optional SMTP. Leave these unset and share links are not emailed. An empty host is not treated as a mail server.
# SPRING_MAIL_HOST=
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# Optional ClamAV. Leave CLAMAV_HOST empty and uploads stay UNSCANNED. They are not marked clean.
CLAMAV_HOST=
CLAMAV_PORT=3310
